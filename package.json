{
  "name": "dsh-im-wechat",
  "version": "0.2.0",
  "type": "module",
  "description": "把微信（WeChat iLink）接入 DeepSeek Harness 的 IM 桥插件",
  "license": "MIT",
  "author": "xbzbing <xbzbing@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xbzbing/dsh-im-wechat.git"
  },
  "homepage": "https://github.com/xbzbing/dsh-im-wechat#readme",
  "bugs": {
    "url": "https://github.com/xbzbing/dsh-im-wechat/issues"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "cordis",
    "wechat",
    "weixin",
    "ilink",
    "im",
    "bridge"
  ],
  "publishConfig": {
    "access": "public"
  },
  "icon": "./assets/icon.svg",
  "main": "./lib/index.js",
  "bin": {
    "dsh-wechat-send": "./bin/dsh-wechat-send.mjs"
  },
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./assets/icon.svg"
  },
  "files": [
    "bin",
    "lib",
    "cordis.patch.yml",
    "locale/*.json",
    "assets/icon.svg",
    "docs/adr",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "prepack": "npm run build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node scripts/build.mjs && node --test test/unit/*.test.ts",
    "verify": "node scripts/verify-package.mjs",
    "check": "npm run typecheck && npm test && npm run verify"
  },
  "engines": {
    "node": ">=24.0.0",
    "dsh": ">=0.2.2-rc.1 <0.3.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh": ">=0.2.2-rc.1 <0.3.0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "@deepseek-ai/dsh": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "@types/react": "18.3.31",
    "esbuild": "0.28.2",
    "typescript": "5.9.3"
  }
}
